{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fresh Guard Alert",
  "type": "object",
  "required": [
    "alert_id",
    "shipment_id",
    "alert_type",
    "severity",
    "message",
    "timestamp"
  ],
  "properties": {
    "alert_id": {
      "type": "string"
    },
    "shipment_id": {
      "type": "string"
    },
    "alert_type": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "acknowledged": {
      "type": "boolean"
    }
  }
}
