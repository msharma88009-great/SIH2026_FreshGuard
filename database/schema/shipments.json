{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fresh Guard Shipment",
  "type": "object",
  "required": [
    "shipment_id",
    "product",
    "origin",
    "destination",
    "status"
  ],
  "properties": {
    "shipment_id": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "freshness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "created_at": {
      "type": "string"
    }
  }
}
